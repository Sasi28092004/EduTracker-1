# ==============================================================================
# EduTracker environment configuration
# Copy this file to server/.env for local development:
#     cp .env.example .env
# Node (server/) reads all of it; PHP (php/config/database.php) reads API_KEY,
# API_BASE_URL and FILE_VIEW_BASE_URL from it when running locally.
# On Render, set these as Environment Variables instead (no .env file needed).
# Never commit real passwords or keys.
# ==============================================================================

# ---------- Node.js server ----------
PORT=3000
NODE_ENV=development

# ---------- MongoDB Atlas ----------
# Atlas -> your cluster -> Connect -> Drivers -> copy the connection string.
# Replace <password> with the database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=edutracker

# ---------- Shared API key (PHP -> Express) ----------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change_me_to_a_long_random_string

# ---------- Default admin (created automatically on first start) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@edutracker.com

# ---------- Gmail SMTP (assignment e-mails & deadline reminders) ----------
# Create a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail_account@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password

# ---------- Used by the PHP frontend ----------
# Where PHP sends API calls (server-to-server)
API_BASE_URL=http://127.0.0.1:3000/api
# Where the BROWSER opens uploaded PDFs from
FILE_VIEW_BASE_URL=http://localhost:3000
